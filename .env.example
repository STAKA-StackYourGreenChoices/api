# Copy to .env for local development.
PORT=7070
NODE_ENV=development
APP_ENV=development

# Points at the Postgres from infra/docker-compose.dev.yml
DATABASE_URL=postgresql://dev:dev@localhost:5432/app?schema=public

# Comma-separated; empty means "no cross-origin browser access"
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_RESET_EXPIRATION=1h

# Email. Links in emails point at the web app.
WEB_APP_URL=http://localhost:3000
# Leave SMTP_URL empty locally: emails are printed to the server log instead.
# Production must set it, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=STAKA <no-reply@example.com>

# Receipt uploads are stored on local disk here (relative to the api folder).
UPLOADS_DIR=uploads

# Optional
SENTRY_DSN=
GIT_SHA=dev
