# Copy to .env for local development.
PORT=7070
NODE_ENV=development
APP_ENV=development

# Points at the Postgres from infra/docker-compose.dev.yml
DATABASE_URL=postgresql://dev:dev@localhost:5432/app?schema=public

# Comma-separated; empty means "no cross-origin browser access"
CORS_ORIGINS=http://localhost:3000

# Optional
SENTRY_DSN=
GIT_SHA=dev
