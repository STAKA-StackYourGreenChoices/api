        ]
      }
    },
    "/digital-cards": {
      "post": {
        "operationId": "DigitalCardsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDigitalCardDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
