  "info": {
    "title": "API",
    "description": "Startup API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "sku",
          "quantity",
          "unitPrice"
        ]
      },
      "OrderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "subtotal": {
            "type": "number",
            "description": "Sum of item lines, in minor units"
          },
          "discount": {
            "type": "number"
          },
          "total": {
            "type": "number",
            "description": "subtotal - discount, clamped at zero"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "PAID",
              "CANCELLED"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          }
        },
        "required": [
          "id",
          "userId",
          "subtotal",
          "discount",
          "total",
          "status",
          "items"
        ]
      },
      "CreateOrderItemDto": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "SKU-ALPHA"
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "minimum": 1
          },
          "unitPrice": {
            "type": "number",
            "example": 1500,
            "description": "Unit price in minor units"
          }
        },
        "required": [
          "sku",
          "quantity",
          "unitPrice"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemDto"
            }
          },
          "discount": {
            "type": "number",
            "default": 0,
            "minimum": 0
          }
        },
        "required": [
          "userId",
          "items"
        ]
      },
      "BrandDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "SustainabilityInfoDto": {
        "type": "object",
        "properties": {
          "carbonScoreGrams": {
            "type": "number"
          },
          "recyclabilityPercent": {
            "type": "number"
          },
          "verified": {
            "type": "boolean"
          },
          "verifiedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "carbonScoreGrams",
          "recyclabilityPercent",
          "verified"
        ]
      },
      "ProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "gtin": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "brand": {
            "$ref": "#/components/schemas/BrandDto"
          },
          "sustainabilityInfo": {
            "$ref": "#/components/schemas/SustainabilityInfoDto"
          }
        },
        "required": [
          "id",
          "gtin",
          "sku",
          "name",
          "brand"
        ]
      },
      "CreateDigitalCardDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "gtin": {
            "type": "string",
            "example": "0000614166626",
            "description": "GTIN from scanned barcode"
          }
        },
        "required": [
          "userId",
          "gtin"
        ]
      },
      "CardUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "CardBrandDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "CardSustainabilityDto": {
        "type": "object",
        "properties": {
          "carbonScoreGrams": {
            "type": "number"
          },
          "recyclabilityPercent": {
            "type": "number"
          },
          "verified": {
            "type": "boolean"
          },
          "verifiedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "carbonScoreGrams",
          "recyclabilityPercent",
          "verified"
        ]
      },
      "CardProductDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "gtin": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "brand": {
            "$ref": "#/components/schemas/CardBrandDto"
          },
          "sustainabilityInfo": {
            "$ref": "#/components/schemas/CardSustainabilityDto"
          }
        },
        "required": [
          "id",
          "gtin",
          "sku",
          "name",
          "brand"
        ]
      },
      "DigitalCardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CardUserDto"
          },
          "product": {
            "$ref": "#/components/schemas/CardProductDto"
          }
        },
        "required": [
          "id",
          "createdAt",
          "user",
          "product"
        ]
      }
    }
  }
}
